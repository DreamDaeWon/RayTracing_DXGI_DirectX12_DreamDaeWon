		return E_FAIL;
	}
	if (nullptr == m_pObject_Manager)
	{
		MSG_BOX(TEXT("nullptr == m_pObject_Manager : CGameInstance::Add_Prototype"));
		return E_FAIL;
	}

	return m_pObject_Manager->Add_Prototype(strPrototypeTag, pPrototype);
}

