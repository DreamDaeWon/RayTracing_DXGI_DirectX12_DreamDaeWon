#include "pch.h"
#include "Weapon_Sasin.h"
#include "GameInstance.h"
#include"Bullet.h"
#include "Effect_Splat_Sasin.h"
#include "Effect_Sasin_Spacle.h"

CWeapon_Sasin::CWeapon_Sasin(LPDIRECT3DDEVICE9 pGraphic_Device) :
	CWeapon(pGraphic_Device)
{
}

CWeapon_Sasin::CWeapon_Sasin(const CWeapon_Sasin& rhs) :
	CWeapon(rhs)
{
}

HRESULT CWeapon_Sasin::Initialize_Prototype()
{
	if (FAILED(__super::Initialize_Prototype()))
	{
		MSG_BOX(TEXT("Failed to Initialize_Prototype : __super,CPlayer"));
		return E_FAIL;
	}
	m_eID = WEAPON_SASIN;
	m_eBulletID = BULLET_SASIN;
	m_fShootingTerm = SASIN_SHOOTING_TERM;
	m_fTerm = SASIN_SHOOTING_TERM;
	m_iMaxBulletNum = 50;
	m_iNowBulletNum = 50;
	m_iExtraBulletNum = 250;
	m_eShooting_Way = SHOOTING_AUTO;
	m_fReboundSize = 2.f;
	m_fCP = 1.f;
	m_iQAimSize = 16;
	m_fMaxGauge = 200.f;
	return S_OK;
}

HRESULT CWeapon_Sasin::Initialize(void* pArg)
{
	if (FAILED(__super::Initialize(pArg)))
	{
		MSG_BOX(TEXT("Failed to Initialize : CWeapon_Sasin"));
		return E_FAIL;
	}

	if (FAILED(Clone_Bullet()))
	{
		MSG_BOX(TEXT("Failed to Clone_Bullet : CWeapon_Sasin"));
		return E_FAIL;
	}

	m_pEffect = dynamic_cast<CEffect_Splat_Sasin*>(m_pGameInstance->Get_Object(LEVEL_STATIC, TEXT("Layer_Effect_Splat_Sasin")));
	if (nullptr == m_pEffect)
	{
		MSG_BOX(TEXT("Failed to Get Effect : CWeapon_Sasin"));
		return E_FAIL;
	}

	m_pEffectSpacle = dynamic_cast<CEffect_Sasin_Spacle*>(m_pGameInstance->Get_Object(LEVEL_STATIC, TEXT("Layer_Effect_Splat_Sasin_Spacle")));
	if (nullptr == m_pEffect)
	{
		MSG_BOX(TEXT("Failed to Get Effect : CWeapon_Sasin"));
		return E_FAIL;
	}

	return S_OK;
}
_uint CWeapon_Sasin::Tick(_float fTimeDelta)
{
	__super::Tick(fTimeDelta);
	if (m_bEx)
	{
		m_fCP = 5.f;
	}
	else
		m_fCP = 1.f;

	return OBJECT_NOTHING;
}
HRESULT CWeapon_Sasin::Clone_Bullet()
{
	CGameObject::GAMEOBJECT_DESC GameObjectDesc = {};
	GameObjectDesc.fSpeedPerSec = 200.f;//?

	for (_uint i = 0; i < m_iMaxBulletNum; i++)
	{
		if (FAILED(m_pGameInstance->Add_Clone(LEVEL_STATIC, TEXT("Layer_Sasin_Bullet"), TEXT("Prototype_GameObject_Bullet"), &GameObjectDesc)))
		{
			MSG_BOX(TEXT("Failed to Ready_Layer_Bullet : CLevel_GamePlay"));
			return E_FAIL;
		}
	}

	m_vecBullet.reserve(m_iMaxBulletNum);

	list<CGameObject*>* pBulletList = m_pGameInstance->Get_List(LEVEL_STATIC, TEXT("Layer_Sasin_Bullet"));
	if (nullptr == pBulletList)
		return E_FAIL;

	auto iter = (*pBulletList).begin();
	for (_uint i = 0; i < m_iMaxBulletNum; i++)
	{
		if (iter == (*pBulletList).end())
			break;
		m_vecBullet.push_back((CBullet*)(*iter));
		Safe_AddRef((*iter));
		iter++;
	}
	for (auto iter : m_vecBullet)
		iter->Set_Frame(1.f);
	m_iNowBulletNum = m_iMaxBulletNum;

	return S_OK;
}

void CWeapon_Sasin::Shot_Bullet()
{
	if (0 >= m_iNowBulletNum || m_iMaxBulletNum < m_iNowBulletNum)
		return;

	_float3 vRayDir = {};
	_float3 vRayPos = {};
	//m_pGameInstance->Get_World_Mouse_Ray(&vRayDir, &vRayPos);
	Get_World_Mouse_Ray_Shot_Grouping(&vRayDir, &vRayPos);
	m_vecBullet[m_iNowBulletNum - 1]->Set_Pos_Dir(vRayPos, vRayDir);
	//pBullet->Set_Pos_Dir(vWeaponPos, vRayDir);
	m_vecBullet[m_iNowBulletNum - 1]->Set_Life_Time();
	--m_iNowBulletNum;
	++m_iCount;



	m_eCurState = STATE_SHOOTING;
	m_fShootingTerm = SASIN_SHOOTING_TERM;

	m_pEffect->Set_Life_Time();

	if(m_iEffectSpacleGo<= m_iCount)
	{
		m_pEffectSpacle->Set_Life_Time();
		m_iCount = 0;
	}
}

HRESULT CWeapon_Sasin::Add_Components()
{

	/* For.Com_VIBuffer */
	if (FAILED(__super::Add_Component(LEVEL_STATIC, TEXT("Prototype_Component_VIBuffer_Rect"), TEXT("Com_VIBuffer"), reinterpret_cast<CComponent**>(&m_pVIBuffer_Com))))
	{
		MSG_BOX(TEXT("Failed to Prototype_Component_VIBuffer_Rect : Add_Components"));
		return E_FAIL;
	}

	/* For.Com_Texture */
	if (FAILED(__super::Add_Component(LEVEL_STATIC, TEXT("Prototype_Component_Texture_Weapon_Sasin"), TEXT("Com_Texture"), reinterpret_cast<CComponent**>(&m_pTextureCom))))
	{
		MSG_BOX(TEXT("Failed to Prototype_Component_Texture_Weapon_Sasin : Add_Components"));
		return E_FAIL;
	}
	if (FAILED(__super::Add_Component(LEVEL_STATIC, TEXT("Prototype_Component_Texture_WeaponEx_Sasin"), TEXT("Com_Texture1"), reinterpret_cast<CComponent**>(&m_pTextureCom1))))
	{
		MSG_BOX(TEXT("Failed to Prototype_Component_Texture_Weapon_Atlas : Add_Components"));
		return E_FAIL;
	}
	return S_OK;
}

CWeapon_Sasin* CWeapon_Sasin::Create(LPDIRECT3DDEVICE9 pGraphic_Device)
{
	CWeapon_Sasin* pInstance = new CWeapon_Sasin(pGraphic_Device);

	if (FAILED(pInstance->Initialize_Prototype()))
	{
		MSG_BOX(TEXT("Failed To Created : CWeapon_Sasin"));

		Safe_Release(pInstance);
	}

	return pInstance;
}

CGameObject* CWeapon_Sasin::Clone(void* pArg)
{
	CWeapon_Sasin* pInstance = new CWeapon_Sasin(*this);

	if (FAILED(pInstance->Initialize(pArg)))
	{
		MSG_BOX(TEXT("Failed To Cloned : CWeapon_Sasin"));

		Safe_Release(pInstance);
	}

	return pInstance;
}

void CWeapon_Sasin::Free()
{
	__super::Free();
}
