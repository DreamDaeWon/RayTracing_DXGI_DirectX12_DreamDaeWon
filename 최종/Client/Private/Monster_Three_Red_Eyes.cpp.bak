CMonster_Three_Red_Eyes* CMonster_Three_Red_Eyes::Create(LPDIRECT3DDEVICE9 pGraphic_Device)
{
	CMonster_Three_Red_Eyes* pInstance = new CMonster_Three_Red_Eyes(pGraphic_Device);
	if (FAILED(pInstance->Initialize_Prototype()))
	{
		MSG_BOX(TEXT("Faild to Created : CMonster_Three_Red_Eyes"));

		Safe_Release(pInstance);
	}

	return pInstance;
}

CGameObject* CMonster_Three_Red_Eyes::Clone(void* pArg)
{
	CMonster_Three_Red_Eyes* pInstance = new CMonster_Three_Red_Eyes(*this);
	if (FAILED(pInstance->Initialize(pArg)))
	{
		MSG_BOX(TEXT("Faild to Cloned : CMonster_Three_Red_Eyes"));

		Safe_Release(pInstance);
	}

	return pInstance;
}

void CMonster_Three_Red_Eyes::Free()
{
	Safe_Release(m_pVIBuffer_Com);
	Safe_Release(m_pTextureIdle);
	Safe_Release(m_pTextureMove);
	Safe_Release(m_pTextureRoll);
	Safe_Release(m_pTextureGunBattle);
	Safe_Release(m_pTextureDeath);
	Safe_Release(m_pCollider_Com[COLLIDER_RECT]);
	Safe_Release(m_pCollider_Com[COLLIDER_CUBE_AABB]);
	Safe_Release(m_pState_Com);
	Safe_Release(m_pTextureCollider);
	Safe_Release(m_pCameraTransform);
	__super::Free();
}
