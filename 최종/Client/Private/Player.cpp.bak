void CPlayer::Collider_Update()
{
	//Collision
	_float4x4 WorldMatrix = *m_pTransform->Get_WorldMatrix();
	m_pCollider_Com[COLLIDER_RECT]->Update_Collider_Info(WorldMatrix);
	m_pCollider_Com[COLLIDER_SPHERE]->Update_Collider_Info(WorldMatrix);
	m_pCollider_Com[COLLIDER_CUBE_AABB]->Update_Collider_Info(WorldMatrix);
}

void CPlayer::Collision(_float fTimeDelta)
{
	//TODO : 콜리전용
	Collision_Wall();
	Collider_Update();
	Collision_Monster_Bullet(fTimeDelta);
	Collision_Trigger();
}

void CPlayer::Collision_Wall()
{
	//중점에서 룩방향(나중에 8방향)으로 스케일(또는 일정거리)크기의 레이를 쏨.
	//쏴서 맞으면 밀어내기.
	_float3 vRayPos = m_pTransform->Get_State(CTransform::STATE_POSITION);
	_float3 vRayDir[4] = {
		 m_pTransform->Get_State(CTransform::STATE_LOOK),
		 m_pTransform->Get_State(CTransform::STATE_RIGHT),
		 -m_pTransform->Get_State(CTransform::STATE_LOOK),
		 -m_pTransform->Get_State(CTransform::STATE_RIGHT)
	};
	_float fLength[4] = {
		D3DXVec3Length(&vRayDir[0]),
		D3DXVec3Length(&vRayDir[1]),
		D3DXVec3Length(&vRayDir[2]),
		D3DXVec3Length(&vRayDir[3])
	};
	for (size_t i = 0; i < 4; i++)
	{
		D3DXVec3Normalize(&vRayDir[i], &vRayDir[i]);
	}
	
	list<CGameObject*>* pWallList = m_pGameInstance->Get_List(g_eLevel, TEXT("Layer_Wall"));
	if (nullptr == pWallList)
		return;

	_float fMinDist(1000.f); //큰 값으로 초기화
	for (auto& iter : *pWallList)//Wall List 전부를 순회하면서 충돌을 판단한다.
	{
		CCollider_Rect* pCollider_Rect = dynamic_cast<CCollider_Rect*>(iter->Get_Component(TEXT("Com_Collider_Rect")));
		if (nullptr == pCollider_Rect)
			continue;
		_float fDist(1000.f);
		for (size_t i = 0; 4 > i; ++i)
		{
			if (m_pGameInstance->Collision_Rect_Ray_Same_Space(pCollider_Rect, vRayDir[i], vRayPos, fLength[i], &fDist)) //충돌이 일어났을 때
			{
				if (fMinDist > fDist) //
				{
					fMinDist = fDist;
					m_pTransform->Set_State(CTransform::STATE_POSITION, vRayPos + vRayDir[i] * (fMinDist - 1.f));
				}
			}
		}
	}
}

void CPlayer::Collision_Trigger()
{
	Collision_Door();

}

void CPlayer::Collision_Door()
{
	if (LEVEL_SNOWBOSS == g_eLevel)
		return;
	CTrigger_Door* pDoor = dynamic_cast<CTrigger_Door*>(m_pGameInstance->Get_Object(g_eLevel, TEXT("Layer_Trigger_Door")));
	if (nullptr == pDoor)
		return;

	CCollider_Sphere* pDoorCollider = dynamic_cast<CCollider_Sphere*>(pDoor->Get_Component(TEXT("Com_Collider_Sphere")));
	if (nullptr == pDoorCollider)
		return;
	CCollider_Sphere* pCollider_Sphere = dynamic_cast<CCollider_Sphere*>(m_pCollider_Com[COLLIDER_SPHERE]);

	if (m_pGameInstance->Collision_Sphere(pCollider_Sphere, pDoorCollider))
	{
		m_pGameInstance->StopAll();

		if (g_eLevel == LEVEL_TUTORIAL)
		{
			g_eLevel = LEVEL_NORMAL1;
			if (FAILED(m_pGameInstance->Open_Level(LEVEL_LOADING, CLevel_Loading::Create(m_pGraphic_Device, LEVEL_NORMAL1))))
				return;

		}
		else if (g_eLevel == LEVEL_NORMAL1)
		{
			g_eLevel = LEVEL_1945;
			if (FAILED(m_pGameInstance->Open_Level(LEVEL_LOADING, CLevel_Loading::Create(m_pGraphic_Device, LEVEL_1945))))
				return;
		}
		else if (g_eLevel == LEVEL_NORMAL2)
		{
			g_eLevel = LEVEL_SNOWBOSS;
			if (FAILED(m_pGameInstance->Open_Level(LEVEL_LOADING, CLevel_Loading::Create(m_pGraphic_Device, LEVEL_SNOWBOSS))))
				return;
		}
	}
}

void CPlayer::Collision_Monster_Bullet(_float fTimeDelta)
{
	//몬스터 불릿 레이어를 가져와서 플레이어의 콜라이더 렉트와 충돌처리를 한다.
	//몬스터 불릿(레이) 플레이어(렉트)
	list<CGameObject*>* pMonsterBulletList = m_pGameInstance->Get_List(g_eLevel, TEXT("Layer_Monster_Bullet"));
	if (nullptr == pMonsterBulletList)
		return;

	//구 충돌
	CCollider_Sphere* pCollider_Sphere = dynamic_cast<CCollider_Sphere*>(m_pCollider_Com[COLLIDER_SPHERE]);
	for (auto iter = pMonsterBulletList->begin(); iter != pMonsterBulletList->end(); ++iter)
	{
		CCollider_Sphere* pMonsterBulletCollider = dynamic_cast<CCollider_Sphere*>(((*iter))->Get_Component(TEXT("Com_Collider_Sphere")));
		if (m_pGameInstance->Collision_Sphere(pCollider_Sphere, pMonsterBulletCollider))
		{
			(*iter)->Set_Dead();
			Set_Hit(true);
		}
	}

}

void CPlayer::Effect_Player_Move(_float fTimeDelta)
{
	//TODO: 용수 발걸음 이펙트 
	if(nullptr == m_pEffectPlayerMove)
	{
		m_pEffectPlayerMove = dynamic_cast<CEffect_Player_Move*> (m_pGameInstance->Get_Object(LEVEL_STATIC, TEXT("Layer_Effect_Player_Move")));
		if(nullptr != m_pEffectPlayerMove)
			Safe_AddRef(m_pEffectPlayerMove);
	}
	if (nullptr != m_pEffectPlayerMove)
	{
		_float3 vCloudPos = m_pTransform->Get_State(CTransform::STATE_POSITION) - m_pTransform->Get_State(CTransform::STATE_UP) * 0.4f;
		m_pEffectPlayerMove->Show_Explosion(vCloudPos, fTimeDelta);
	}
}

void CPlayer::Key_Input(_float fTimeDelta)
{

	_uint iRand = rand() % 5;
	//TODO: 예은 - HP UI 연동 확인용
	m_fTime += fTimeDelta;
	m_fTimeForfoot += fTimeDelta;
	if ((GetKeyState('H') & 0x8000) && m_fTime >= 2.f)
	{
		m_bHit = true;
	}
	if ((GetKeyState('Y') & 0x8000) && m_fTime >= 2.f && m_pStateCom->Get_State(CState::STATE_HP) < 3.f)
	{
		m_pStateCom->Set_Hp(1.f);
	}
	
	//스킬
	if (nullptr != m_pSkillSlot[SPACE_SKILL]) //Roll 고정
	{
		if (m_fSp - m_pSkillSlot[SPACE_SKILL]->Get_SpendSp() < 0.f)
		{
			m_pSkillSlot[SPACE_SKILL]->Set_Activate(false);
			m_pSkillSlot[SPACE_SKILL]->Set_No(true);

		}
		else if (m_pGameInstance->Key_Pressing(VK_SPACE) && m_pSkillCoolTime[SPACE_SKILL] > (m_pSkillSlot[SPACE_SKILL])->Get_CoolTime())
		{
			m_pGameInstance->StopSound(CSound_Manager::PLAYER);
			m_fSp -= m_pSkillSlot[SPACE_SKILL]->Get_SpendSp();
 			m_eCurState = STATE_ROLL;
			m_fTexture = 0.f;
			m_pSkillCoolTime[SPACE_SKILL] = 0.f;
			m_bRollDone = false;
			m_pSkillSlot[SPACE_SKILL]->Set_Activate(true);
			m_pGameInstance->PlaySoundW(TEXT("roll.wav"),CSound_Manager::PLAYER,0.2f);
		}
	}
	if (nullptr != m_pSkillSlot[SHIFT_SKILL])
	{
		if (m_pGameInstance->Key_Pressing(VK_SHIFT) && m_pSkillCoolTime[SHIFT_SKILL] > (m_pSkillSlot[SHIFT_SKILL])->Get_CoolTime())
		{
			m_fSp -= m_pSkillSlot[SHIFT_SKILL]->Get_SpendSp();
			m_fTexture = 0.f;
			m_pSkillCoolTime[SHIFT_SKILL] = 0.f;
			m_pSkillSlot[SHIFT_SKILL]->Set_Activate(true);
		}
	}
	//if (nullptr != m_pSkillSlot[Q_SKILL])
	//{
	//	if (m_pGameInstance->Key_Pressing('Q') && m_pSkillCoolTime[Q_SKILL] > (m_pSkillSlot[Q_SKILL])->Get_CoolTime())
	//	{
	//		m_fTexture = 0.f;
	//		m_pSkillCoolTime[Q_SKILL] = 0.f;
	//		m_pSkillSlot[Q_SKILL]->Set_Activate(true);
	//	}
	//}
	//if(nullptr != m_pSkillSlot[F_SKILL])
	//{
	//	if (m_pGameInstance->Key_Pressing('F') && m_pSkillCoolTime[F_SKILL] > (m_pSkillSlot[F_SKILL])->Get_CoolTime())
	//	{
	//		m_fTexture = 0.f;
	//		m_pSkillCoolTime[F_SKILL] = 0.f;
	//		m_pSkillSlot[F_SKILL]->Set_Activate(true);
	//	}
	//}
	
	//무기
	if (m_pGameInstance->Key_Pressing('1'))
	{
		if (nullptr != m_pWeaponSlot[FIRST_WEAPON])
		{
			if(m_iSelectWeapon != FIRST_WEAPON)
				m_eCurAiming = AIMING_GUN_CHANGE;
			m_iSelectWeapon = FIRST_WEAPON;
			if (nullptr != m_pWeaponSlot[SECOND_WEAPON])
				m_pWeaponSlot[SECOND_WEAPON]->Set_Idle();
			if (nullptr != m_pWeaponSlot[THIRD_WEAPON])
				m_pWeaponSlot[THIRD_WEAPON]->Set_Idle();
		}
	}
	if (m_pGameInstance->Key_Pressing('2'))
	{
		if (nullptr != m_pWeaponSlot[SECOND_WEAPON])
		{
			if (m_iSelectWeapon != SECOND_WEAPON)
				m_eCurAiming = AIMING_GUN_CHANGE;
			m_iSelectWeapon = SECOND_WEAPON;
			if (nullptr != m_pWeaponSlot[FIRST_WEAPON])			
				m_pWeaponSlot[FIRST_WEAPON]->Set_Idle();

			if (nullptr != m_pWeaponSlot[THIRD_WEAPON])
				m_pWeaponSlot[THIRD_WEAPON]->Set_Idle();
		}
	}
	if (m_pGameInstance->Key_Pressing('3'))
	{
		if (nullptr != m_pWeaponSlot[THIRD_WEAPON])
		{
			if (m_iSelectWeapon != THIRD_WEAPON)
				m_eCurAiming = AIMING_GUN_CHANGE;
			m_iSelectWeapon = THIRD_WEAPON;
			if(nullptr != m_pWeaponSlot[FIRST_WEAPON])
				m_pWeaponSlot[FIRST_WEAPON]->Set_Idle();
			if (nullptr != m_pWeaponSlot[SECOND_WEAPON])
			m_pWeaponSlot[SECOND_WEAPON]->Set_Idle();
		}
	}


	if ((m_pGameInstance->Key_Pressing(VK_RBUTTON)||m_ePreState == STATE_AIMING_ZOOM )&& m_bRollDone)
	{
		m_pWeaponSlot[m_iSelectWeapon]->Set_State(CWeapon::STATE_AIMING);

		if (m_bFirstAim)
		{
			Look_At_Aim();
			m_bFirstAim = false;
		}

		m_eCurState = STATE_AIMING;

		_float3 vWDir = { 0.f,0.f,0.f };
		_float3 vSDir = { 0.f,0.f,0.f };
		_float3 vADir = { 0.f,0.f,0.f };
		_float3 vDDir = { 0.f,0.f,0.f };



		if (m_pGameInstance->Key_Pressing('A'))
		{
			if (m_fTimeForfoot > 0.2f)
			{
				TCHAR	szBuf[256] = L"";
				swprintf_s(szBuf, L"footstep_0%d.wav", iRand);
				m_pGameInstance->PlaySoundW(szBuf, CSound_Manager::PLAYER, 0.4f);
				m_fTimeForfoot = 0.f;

			}

			m_bChange = true;
			m_eCurState = STATE_AIMING_WALK;

			//Effect_Player_Move(fTimeDelta * 0.3f); //용수: 발걸음 이펙트

			if (m_pGameInstance->Key_Pressing('W'))
			{
				m_pTransform->Go_SL(fTimeDelta * 0.3f, &vADir);
				m_eWalk = WALK_STRIAGHT;
			}
			else if (m_pGameInstance->Key_Pressing('S'))
			{
				m_pTransform->Go_BL(fTimeDelta * 0.3f, &vADir);
				m_eWalk = WALK_BACK;
			}
			else
			{
				m_pTransform->Go_Left(fTimeDelta * 0.3f);
				vADir = -m_pTransform->Get_State(CTransform::STATE_RIGHT);
			}
			//D3DXVec3Normalize(&vADir, &vADir);
		}
		else if (m_pGameInstance->Key_Pressing('D'))
		{
			if (m_fTimeForfoot > 0.2f)
			{
				TCHAR	szBuf[256] = L"";
				swprintf_s(szBuf, L"footstep_0%d.wav", iRand);
				m_pGameInstance->PlaySoundW(szBuf, CSound_Manager::PLAYER, 0.4f);
				m_fTimeForfoot = 0.f;
			}

			m_bChange = true;
			m_eCurState = STATE_AIMING_WALK;

			//Effect_Player_Move(fTimeDelta * 0.3f); //용수: 발걸음 이펙트

			if (m_pGameInstance->Key_Pressing('W'))
			{
				m_eWalk = WALK_STRIAGHT;
				m_pTransform->Go_SR(fTimeDelta * 0.3f, &vDDir);
			}
			else if (m_pGameInstance->Key_Pressing('S'))
			{
				m_pTransform->Go_BR(fTimeDelta * 0.3f, &vDDir);
				m_eWalk = WALK_BACK;
			}
			else
			{
				m_pTransform->Go_Right(fTimeDelta * 0.3f);
				vDDir = m_pTransform->Get_State(CTransform::STATE_RIGHT);
			}

		}
		else if (m_pGameInstance->Key_Pressing('W'))
		{
			if (m_fTimeForfoot > 0.2f)
			{
				TCHAR	szBuf[256] = L"";
				swprintf_s(szBuf, L"footstep_0%d.wav", iRand);
				m_pGameInstance->PlaySoundW(szBuf, CSound_Manager::PLAYER, 0.4f);
				m_fTimeForfoot = 0.f;

			}

			m_eWalk = WALK_STRIAGHT;
			m_bChange = true;
			m_eCurState = STATE_AIMING_WALK;

			//Effect_Player_Move(fTimeDelta * 0.3f); //용수: 발걸음 이펙트

			if (m_pGameInstance->Key_Pressing('D'))
				m_pTransform->Go_SR(fTimeDelta * 0.3f, &vWDir);
			else if (m_pGameInstance->Key_Pressing('A'))
				m_pTransform->Go_SL(fTimeDelta * 0.3f, &vWDir);
			else
			{
				m_pTransform->Go_Straight(fTimeDelta * 0.3f);
				vWDir = m_pTransform->Get_State(CTransform::STATE_LOOK);
			}
		}
		else if (m_pGameInstance->Key_Pressing('S'))
		{
			if (m_fTimeForfoot > 0.2f)
			{
				TCHAR	szBuf[256] = L"";
				swprintf_s(szBuf, L"footstep_0%d.wav", iRand);
				m_pGameInstance->PlaySoundW(szBuf, CSound_Manager::PLAYER, 0.4f);
				m_fTimeForfoot = 0.f;

			}
			m_eWalk = WALK_BACK;
			m_bChange = true;
			m_eCurState = STATE_AIMING_WALK;

			//Effect_Player_Move(fTimeDelta * 0.3f); //용수: 발걸음 이펙트

			if (m_pGameInstance->Key_Pressing('D'))
				m_pTransform->Go_BR(fTimeDelta * 0.3f, &vSDir);
			else if (m_pGameInstance->Key_Pressing('A'))
				m_pTransform->Go_BL(fTimeDelta * 0.3f, &vSDir);
			else
			{
				m_pTransform->Go_Backward(fTimeDelta * 0.3f);
				vSDir = -m_pTransform->Get_State(CTransform::STATE_LOOK);
			}

		}
		if (m_pGameInstance->Key_Pressing(VK_MBUTTON) && m_pWeaponSlot[m_iSelectWeapon]->Get_ID() == CWeapon::WEAPON_SPARROW)
			m_eCurState = STATE_AIMING_ZOOM;

		if (m_bChange == true)
		{
			m_vPlayerLook = vWDir + vSDir + vADir + vDDir;
			m_bChange = false;
		}
		m_bFirstReLoad = true;


		//m_vPlayerLook = m_pTransform->Get_State(CTransform::STATE_LOOK);
	}
	else if(m_bRollDone)
	{
		for (size_t i = 0; i < WEAPON_SLOT_END; i++)
		{
			if (nullptr != m_pWeaponSlot[i])
			{
				m_pWeaponSlot[i]->Reload();
				m_pWeaponSlot[i]->Set_Idle();
			}
		}
		if (m_bFirstReLoad)
		{
			m_pGameInstance->StopSound(CSound_Manager::CHANNEL_WEAPON);
			m_pGameInstance->PlaySoundW(TEXT("Reload_Analog.wav"), CSound_Manager::CHANNEL_WEAPON, 0.3f);
			m_bFirstReLoad = false;
		}
		
		m_fSp += fTimeDelta*2.f;
		if (m_fSp >= 200.f)
			m_fSp = 200.f;
		_float3 vWDir = { 0.f,0.f,0.f };
		_float3 vSDir = { 0.f,0.f,0.f };
		_float3 vADir = { 0.f,0.f,0.f };
		_float3 vDDir = { 0.f,0.f,0.f };



		m_eCurState = STATE_IDLE;
		if (m_pGameInstance->Key_Pressing('A'))
		{

			TCHAR	szBuf[256] = L"";
			swprintf_s(szBuf, L"footstep_0%d.wav", iRand);
			m_pGameInstance->PlaySoundW(szBuf, CSound_Manager::PLAYER, 0.4f);

			m_eCurState = STATE_IDLE_WALK;
			m_bChange = true;

			Effect_Player_Move(fTimeDelta); //용수: 발걸음 이펙트

			if (m_pGameInstance->Key_Pressing('W'))
				m_pTransform->Go_SL(fTimeDelta, &vADir);
			else if (m_pGameInstance->Key_Pressing('S'))
				m_pTransform->Go_BL(fTimeDelta, &vADir);
			else
			{
				m_pTransform->Go_Left(fTimeDelta);
				vADir = -m_pTransform->Get_State(CTransform::STATE_RIGHT);
			}
			//D3DXVec3Normalize(&vADir, &vADir);
		}
		else if (m_pGameInstance->Key_Pressing('D'))
		{
			TCHAR	szBuf[256] = L"";
			swprintf_s(szBuf, L"footstep_0%d.wav", iRand);
			m_pGameInstance->PlaySoundW(szBuf, CSound_Manager::PLAYER, 0.4f);

			m_eCurState = STATE_IDLE_WALK;
			m_bChange = true;

			Effect_Player_Move(fTimeDelta); //용수: 발걸음 이펙트

			if (m_pGameInstance->Key_Pressing('W'))
				m_pTransform->Go_SR(fTimeDelta, &vDDir);
			else if (m_pGameInstance->Key_Pressing('S'))
				m_pTransform->Go_BR(fTimeDelta, &vDDir);
			else
			{
				m_pTransform->Go_Right(fTimeDelta);
				vDDir = m_pTransform->Get_State(CTransform::STATE_RIGHT);
			}

		}
		else if (m_pGameInstance->Key_Pressing('W'))
		{
			TCHAR	szBuf[256] = L"";
			swprintf_s(szBuf, L"footstep_0%d.wav", iRand);
			m_pGameInstance->PlaySoundW(szBuf, CSound_Manager::PLAYER, 0.4f);

			m_eCurState = STATE_IDLE_WALK;
			m_bChange = true;

			Effect_Player_Move(fTimeDelta); //용수: 발걸음 이펙트

			if (m_pGameInstance->Key_Pressing('D'))
				m_pTransform->Go_SR(fTimeDelta, &vWDir);
			else if (m_pGameInstance->Key_Pressing('A'))
				m_pTransform->Go_SL(fTimeDelta, &vWDir);
			else
			{
				m_pTransform->Go_Straight(fTimeDelta);
				vWDir = m_pTransform->Get_State(CTransform::STATE_LOOK);
			}
		}
		else if (m_pGameInstance->Key_Pressing('S'))
		{
			TCHAR	szBuf[256] = L"";
			swprintf_s(szBuf, L"footstep_0%d.wav", iRand);
			m_pGameInstance->PlaySoundW(szBuf, CSound_Manager::PLAYER, 0.4f);

			m_eCurState = STATE_IDLE_WALK;
			m_bChange = true;

			Effect_Player_Move(fTimeDelta); //용수: 발걸음 이펙트

			if (m_pGameInstance->Key_Pressing('D'))
				m_pTransform->Go_BR(fTimeDelta, &vSDir);
			else if (m_pGameInstance->Key_Pressing('A'))
				m_pTransform->Go_BL(fTimeDelta, &vSDir);
			else
			{
				m_pTransform->Go_Backward(fTimeDelta);
				vSDir = -m_pTransform->Get_State(CTransform::STATE_LOOK);
			}
			//D3DXVec3Normalize(&vSDir, &vSDir);

		}
		m_bFirstAim = true;
		
		if (m_bChange == true)
		{
			m_vPlayerLook = vWDir + vSDir + vADir + vDDir;
			m_bChange = false;
		}
		
	}

	if ((m_i3Shooting && m_fTime > m_pWeaponSlot[m_iSelectWeapon]->Get_ShootingTerm() )||((m_pGameInstance->Key_Pressing(VK_RBUTTON)||m_eCurState == STATE_AIMING_ZOOM )&& m_pWeaponSlot[m_iSelectWeapon]->Get_ShootingWay() == 2 &&
		m_pGameInstance->Key_Down(VK_LBUTTON) && m_fTime > m_pWeaponSlot[m_iSelectWeapon]->Get_ShootingTerm()
		))
	{
		if (m_i3Shooting < 3)
		{
			if (m_pWeaponSlot[m_iSelectWeapon]->Get_Weapon_Bullet_Info().iNowBulletNum > 0)
			{
				m_pGameInstance->StopSound(CSound_Manager::CHANNEL_WEAPON);
				Shot_Bullet();
				m_eCurAiming = AIMING_SHOOT;
				m_fTime = 0.f;
				++m_i3Shooting;
			}
			else
			{
				m_fTime = 0.f;

				//장전하라는 경고
			}
		}
		else
		{
			m_i3Shooting = 0;
		}
		
	}
	else if ((m_pGameInstance->Key_Pressing(VK_RBUTTON) || m_eCurState == STATE_AIMING_ZOOM) && m_pWeaponSlot[m_iSelectWeapon]->Get_ShootingWay()==0&&
		m_pGameInstance->Key_Pressing(VK_LBUTTON)
		&& m_fTime > m_pWeaponSlot[m_iSelectWeapon]->Get_ShootingTerm() ) //총 텀
	{
		if (m_pWeaponSlot[m_iSelectWeapon]->Get_Weapon_Bullet_Info().iNowBulletNum > 0)
		{
			m_pGameInstance->StopSound(CSound_Manager::CHANNEL_WEAPON);
			Shot_Bullet();
			m_eCurAiming = AIMING_SHOOT;
			m_fTime = 0.f;
		}
		else
		{
			m_fTime = 0.f;

			//장전하라는 경고
		}
	}
	else if ((m_pGameInstance->Key_Pressing(VK_RBUTTON) || m_eCurState == STATE_AIMING_ZOOM) && m_pWeaponSlot[m_iSelectWeapon]->Get_ShootingWay() == 1 &&
		m_pGameInstance->Key_Down(VK_LBUTTON)
		&& m_fTime > m_pWeaponSlot[m_iSelectWeapon]->Get_ShootingTerm())
	{
		if (m_pWeaponSlot[m_iSelectWeapon]->Get_Weapon_Bullet_Info().iNowBulletNum > 0)
		{
			m_pGameInstance->StopSound(CSound_Manager::CHANNEL_WEAPON);
			Shot_Bullet();
			m_eCurAiming = AIMING_SHOOT;
			m_fTime = 0.f;
		}
		else
		{
			m_fTime = 0.f;

			//장전하라는 경고
		}
	}


}


CPlayer* CPlayer::Create(LPDIRECT3DDEVICE9 pGraphic_Device)
{
	CPlayer* pInstance = new CPlayer(pGraphic_Device);
	if (FAILED(pInstance->Initialize_Prototype()))
	{
		MSG_BOX(TEXT("Faild to Created : CPlayer"));

		Safe_Release(pInstance);
	}

	return pInstance;
}

CGameObject* CPlayer::Clone(void* pArg)
{
	CPlayer* pInstance = new CPlayer(*this);
	if (FAILED(pInstance->Initialize(pArg)))
	{
		MSG_BOX(TEXT("Faild to Cloned : CPlayer"));

		Safe_Release(pInstance);
	}
	
	return pInstance;
}

void CPlayer::Free()
{
	m_pTextureCom = nullptr;
	Safe_Release(m_pVIBuffer_Com);
	Safe_Release(m_pTextureIdle);
	Safe_Release(m_pTextureMove);
	Safe_Release(m_pTextureRoll);
	Safe_Release(m_pTextureTPS);
	Safe_Release(m_pTextureDeath);
	Safe_Release(m_pTextureTPS_Body);
	Safe_Release(m_pTextureTPS_Hand);
	Safe_Release(m_pTextureTPS_Head);
	Safe_Release(m_pStateCom);
	Safe_Release(m_pCollider_Com[COLLIDER_SPHERE]);
	Safe_Release(m_pCollider_Com[COLLIDER_RECT]);
	Safe_Release(m_pCollider_Com[COLLIDER_CUBE_AABB]);
	Safe_Release(m_pEffectPlayerMove);
	Safe_Release(m_pDWCameraTranformCom);
	//Safe_Release(m_pCamera);

	__super::Free();
}
