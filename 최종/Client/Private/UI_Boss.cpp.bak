#include "pch.h"
#include "UI_Boss.h"
#include "GameInstance.h"
#include "State.h"

CUI_Boss::CUI_Boss(LPDIRECT3DDEVICE9 pGraphic_Device)
	:CUI_Base(pGraphic_Device)
{
}

CUI_Boss::CUI_Boss(const CUI_Base& rhs)
	:CUI_Base(rhs)
{
}

HRESULT CUI_Boss::Initialize_Prototype()
{
	return S_OK;
}

HRESULT CUI_Boss::Initialize(void* pArg)
{


 	if (FAILED(__super::Initialize(pArg)))
		return E_FAIL;
	if (nullptr != pArg)
	{
		UI_BOSS_DESC* pUI_Boss_Desc = (UI_BOSS_DESC*)pArg;
		m_pBossStateCom = pUI_Boss_Desc->pBossStateCom;
		Safe_AddRef(m_pBossStateCom);
		if (nullptr == m_pBossStateCom)
			return E_FAIL;
	}
	if (FAILED(Add_Components()))
		return E_FAIL;

	D3DXMatrixIdentity(&m_ViewMatrix);

	D3DXMatrixOrthoLH(&m_ProjMatrix, g_iWinSizeX, g_iWinSizeY, 0.0f, 1.f);

	m_fSizeX = 1024.f;
	m_fSizeY = 64.f;
	m_fX = g_iWinSizeX * 0.5f + 10.f;
	m_fY = 40.f;

	m_pTransform->Set_Scale(_float3(m_fSizeX*0.8f, m_fSizeY*0.8f , 1.f));
	m_pTransform->Set_State(CTransform::STATE_POSITION, _float3(
		m_fX - g_iWinSizeX * 0.5f,
		-m_fY + g_iWinSizeY * 0.5f,
		0.f
	));
	m_fCurHp = m_pBossStateCom->Get_State(CState::STATE_HP);
	m_fPreHp = m_pBossStateCom->Get_State(CState::STATE_HP);
	m_fPreHpForY = m_pBossStateCom->Get_State(CState::STATE_HP);

	m_fMaxHp = m_pBossStateCom->Get_State(CState::STATE_MAXHP);
	m_vFirstWorldMatrix = *m_pTransform->Get_WorldMatrix();
	return S_OK; 
}

_uint CUI_Boss::Tick(_float fTimeDelta)
{
	if (m_pBossStateCom->Get_State(CState::STATE_DEAD))
		return OBJECT_DEAD;
	m_fTime += fTimeDelta;
	if (m_bMove)
		m_fTime1 += fTimeDelta;
	m_fCurHp = m_pBossStateCom->Get_State(CState::STATE_HP);

	if (m_fPreHp != m_fCurHp)
	{
		m_fGap += m_fPreHp - m_fCurHp;
		m_fPreHp = m_fCurHp;
		m_bMove = false;
		m_bHit = true;
		m_fTime = 0.f;
	}
	else if (m_bHit&&m_fTime >= 1.5f)
	{
		m_fTime = 1.5f;
		m_bMove = true;
	}
	if (m_fCurHp > m_fPreHpForY - m_fGap * m_fTime1)
	{
		m_bHit = false;
		m_fPreHpForY = m_fCurHp;
		m_bMove = false;
		m_fTime1 = 0.f;
	}

	return OBJECT_NOTHING;
}

void CUI_Boss::Late_Tick(_float fTimeDelta)
{
	m_pGameInstance->Add_RenderObject(CRenderer::RENDER_UI, this);

}

HRESULT CUI_Boss::Render()
{

	m_pGraphic_Device->SetTransform(D3DTS_VIEW, &m_ViewMatrix);
	m_pGraphic_Device->SetTransform(D3DTS_PROJECTION, &m_ProjMatrix);


	//그로기 프레임 뒷배경
	m_pTextureCom = m_pTextureGroggy;
	if (FAILED(Render_Again(557.f, 29.f, m_fX, m_fY, 0, 20)))
		return E_FAIL;
	Reset_First_State();
	// 그로기 게이지
	if (FAILED(Render_Again(557.f, 29.f, m_fX, m_fY, 1, 0)))
		return E_FAIL;
	Reset_First_State();
	//그로기 프레임
	if (FAILED(Render_Again(557.f, 29.f, m_fX, m_fY, 2, 20)))
		return E_FAIL;
	Reset_First_State();
	//그로기 위 점박이
	if (FAILED(Render_Again(557.f, 29.f, m_fX, m_fY - 20.f, 3, 0)))
		return E_FAIL;
	Reset_First_State();
	//Hp 프레임 뒷배경
	m_pTextureCom = m_pTextureHp;
	if (FAILED(Render_Again(542.f, 15.f , m_fX, m_fY, 0, 20)))
		return E_FAIL;
	Reset_First_State();
	// Hp 게이지
	if (FAILED(Render_Again((m_fPreHpForY - m_fTime1 * m_fGap) * (542.f / m_fMaxHp), 15.f, m_fX - ((m_fMaxHp - (m_fPreHpForY - m_fTime1 * m_fGap)) * (542.f / m_fMaxHp) * 0.49f), m_fY, 3, 0)))
		return E_FAIL;
	Reset_First_State();

	if (FAILED(Render_Again(m_fCurHp * (542.f / m_fMaxHp), 15.f, m_fX - ((m_fMaxHp - m_fCurHp) * (542.f / m_fMaxHp) * 0.49f), m_fY, 1, 0)))
		return E_FAIL;
	Reset_First_State();


	//Hp 프레임
	if (FAILED(Render_Again(542.f, 15.f, m_fX, m_fY, 2, 20)))
		return E_FAIL;
	Reset_First_State();

	if (FAILED(Reset_RenderState()))
		return E_FAIL;


	return S_OK;
}


HRESULT CUI_Boss::Render_Again(_float fSizeX, _float fSizeY, _float fX, _float fY, _uint iFrame, _uint iRenderState)
{
	//m_pTransform->Turn(_float3(1.f, 1.f, 0.f), 0.001f);
	m_pTransform->Set_Scale(_float3(fSizeX, fSizeY, 1.f));

	m_pTransform->Set_State(CTransform::STATE_POSITION, _float3(
		fX - g_iWinSizeX * 0.5f,
		-fY + g_iWinSizeY * 0.5f,
		0.f
	));

	if (FAILED(m_pTransform->Bind_WorldMatrix()))
		return E_FAIL;

	if (FAILED(m_pTextureCom->Bind_Texture(0, (_uint)iFrame)))
		return E_FAIL;


	if (FAILED(Set_RenderState(iRenderState)))
		return E_FAIL;
	if (FAILED(m_pVIBufferCom->Render()))
		return E_FAIL;


	return S_OK;
}

void CUI_Boss::Reset_First_State()
{
	m_pTransform->Set_WorldMatrix(m_vFirstWorldMatrix);
}

HRESULT CUI_Boss::Add_Components()
{
	/* For.Com_VIBuffer */
	if (FAILED(__super::Add_Component(LEVEL_STATIC, TEXT("Prototype_Component_VIBuffer_Rect"),
		TEXT("Com_VIBuffer"), (CComponent**)&m_pVIBufferCom)))
		return E_FAIL;

	/* For.Com_Texture */
	if (FAILED(__super::Add_Component(g_eLevel, TEXT("Prototype_Component_Texture_UI_Boss_Hp"),
		TEXT("Com_Texture"), (CComponent**)&m_pTextureHp)))
		return E_FAIL;
	if (FAILED(__super::Add_Component(g_eLevel, TEXT("Prototype_Component_Texture_UI_Boss_Groggy"),
		TEXT("Com_Texture1"), (CComponent**)&m_pTextureGroggy)))
		return E_FAIL;


	return S_OK;
}

HRESULT CUI_Boss::Set_RenderState(_ulong lAphaRef)
{
	m_pGraphic_Device->SetSamplerState(0, D3DSAMP_MINFILTER, D3DTEXF_POINT);
	m_pGraphic_Device->SetSamplerState(0, D3DSAMP_MAGFILTER, D3DTEXF_POINT);
	m_pGraphic_Device->SetSamplerState(0, D3DSAMP_MIPFILTER, D3DTEXF_POINT);
	m_pGraphic_Device->SetRenderState(D3DRS_ALPHATESTENABLE, TRUE);
	m_pGraphic_Device->SetRenderState(D3DRS_ALPHAREF, lAphaRef);
	m_pGraphic_Device->SetRenderState(D3DRS_ALPHAFUNC, D3DCMP_GREATER);
	m_pGraphic_Device->SetRenderState(D3DRS_ALPHABLENDENABLE, TRUE);
	m_pGraphic_Device->SetRenderState(D3DRS_SRCBLEND, D3DBLEND_SRCALPHA);
	m_pGraphic_Device->SetRenderState(D3DRS_DESTBLEND, D3DBLEND_INVSRCALPHA);
	m_pGraphic_Device->SetRenderState(D3DRS_BLENDOP, D3DBLENDOP_ADD);

	m_pGraphic_Device->SetRenderState(D3DRS_ZENABLE, FALSE);
	m_pGraphic_Device->SetRenderState(D3DRS_ZWRITEENABLE, TRUE);
	return S_OK;
}

HRESULT CUI_Boss::Reset_RenderState()
{
	m_pGraphic_Device->SetRenderState(D3DRS_ALPHABLENDENABLE, FALSE);

	m_pGraphic_Device->SetSamplerState(0, D3DSAMP_MINFILTER, D3DTEXF_LINEAR);
	m_pGraphic_Device->SetSamplerState(0, D3DSAMP_MAGFILTER, D3DTEXF_LINEAR);
	m_pGraphic_Device->SetSamplerState(0, D3DSAMP_MIPFILTER, D3DTEXF_LINEAR);
	m_pGraphic_Device->SetRenderState(D3DRS_ALPHATESTENABLE, FALSE);

	m_pGraphic_Device->SetRenderState(D3DRS_ZENABLE, TRUE);
	m_pGraphic_Device->SetRenderState(D3DRS_ZWRITEENABLE, TRUE);

	return S_OK;
}

CUI_Boss* CUI_Boss::Create(LPDIRECT3DDEVICE9 pGraphic_Device)
{
	CUI_Boss* pInstance = new CUI_Boss(pGraphic_Device);

	if (FAILED(pInstance->Initialize_Prototype()))
	{
		MSG_BOX(TEXT("Failed To Created : CUI_Boss"));

		Safe_Release(pInstance);
	}

	return pInstance;
}

CGameObject* CUI_Boss::Clone(void* pArg)
{
	CUI_Boss* pInstance = new CUI_Boss(*this);

	if (FAILED(pInstance->Initialize(pArg)))
	{
		MSG_BOX(TEXT("Failed To Cloned : CUI_Boss"));

		Safe_Release(pInstance);
	}

	return pInstance;
}

void CUI_Boss::Free()
{
	m_pTextureCom = nullptr;
	Safe_Release(m_pBossStateCom);
	Safe_Release(m_pTextureHp);
	Safe_Release(m_pTextureGroggy);
	__super::Free();
}
